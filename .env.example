# LifeFresh QuickNote Pro — local secrets template
# ------------------------------------------------
# Copy this file to `.env` in the project root and fill in your own keys.
# `.env` is git-ignored; `.env.example` is the only tracked template.
#
#   cp .env.example .env
#
# These are read by app/build.gradle.kts and injected into BuildConfig
# (BuildConfig.GEMINI_API_KEY / BuildConfig.GROQ_API_KEY).
# The app degrades gracefully: if a key is blank, that AI provider is
# simply reported as "not configured" by ai/chat/config/AIConfig.kt.

# --- Gemini (primary AI provider) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Groq (fallback AI provider, optional) ---
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Release signing (optional, only for signed release builds) ---
# If `lifefresh-quicknote-pro-upload.jks` is not present at the project root,
# the release signing config is skipped automatically by the build script.
# KEYSTORE_PATH=
# KEY_ALIAS=lifefreshpro
# STORE_PASSWORD=
# KEY_PASSWORD=
